# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=reflow

# Monad RPC (optional override)
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# MON → USD for market cap / volume display (testnet default 1)
# NEXT_PUBLIC_MON_USD=1

# Optional address overrides (defaults from config/deployments/monadTestnet.json)
# NEXT_PUBLIC_CORE=
# NEXT_PUBLIC_BONDING_CURVE_FACTORY=
# NEXT_PUBLIC_DEX_ROUTER=
# NEXT_PUBLIC_LP_VAULT=
# NEXT_PUBLIC_ACTIVITY_MONITOR=
# NEXT_PUBLIC_GOVERNOR=
# NEXT_PUBLIC_WNATIVE=
# NEXT_PUBLIC_FEE_VAULT=
# NEXT_PUBLIC_DEX_FACTORY=
# NEXT_PUBLIC_DEPLOYER=
# Operator wallet that can see Launch pool / recycle admin buttons
# NEXT_PUBLIC_OPERATOR_ADDRESS=0xdAF0182De86F904918Db8d07c7340A1EfcDF8244

# Optional hosted subgraph URL (The Graph Studio). Prefer NEXT_PUBLIC_ for client use.
# NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<ID>/reflow/version/latest
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/<ID>/reflow/version/latest
# SUBGRAPH_NAME=reflow
